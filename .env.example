# LeanChat Konfiguration.
# Beim ersten Programmstart wird diese Datei automatisch als `.env` kopiert
# (die `.env` selbst ist nicht in Git eingecheckt). Werte in der echten
# Systemumgebung haben Vorrang vor den Werten aus der `.env`.

# --- Daten-Root: alle Laufzeitdaten liegen darunter ---
LEANCHAT_DATA_DIR=data

# --- Pfade der Datenbanken (Default: unterhalb von LEANCHAT_DATA_DIR) ---
# User Registry (Login-Credentials, verwaltet von der user_registry-Bibliothek)
# LEANCHAT_REGISTRY_PATH=data/user_registry.db
# Pro-User SQLite-Dateien (mit dem Schluessel aus der Registry verschluesselt)
# LEANCHAT_USERS_DIR=data/users
# Eigener Pfad fuer die App-Config-JSON (Default: <LEANCHAT_DATA_DIR>/app_config.json)
# LEANCHAT_CONFIG_PATH=

# --- Server-Secret fuer die signierten Session-Cookies ---
# Leer lassen: beim Start wird automatisch ein Secret in <LEANCHAT_DATA_DIR>/.secret erzeugt
LEANCHAT_SECRET=

# --- Anzeigename der App (Browser-Titel + Header) ---
# LEANCHAT_APP_NAME=LeanChat

# --- LLM-Endpunkt (OpenAI-kompatibel) ---
# Server-Default fuer Host/Port; daraus wird die Base-URL http://<host>:<port>/v1
# berechnet (Single Source of Truth; pro User in den Einstellungen ueberschreibbar)
LEANCHAT_LLM_HOST=127.0.0.1
LEANCHAT_LLM_PORT=1234
LEANCHAT_MODEL=openai/google/gemma-4-e4b
# Globaler API-Key (Fallback; pro User in den Einstellungen ueberschreibbar)
LEANCHAT_API_KEY=lmstudio

# --- Server-Adresse fuer `python -m app` ---
LEANCHAT_HOST=0.0.0.0
LEANCHAT_PORT=8000

# --- TLS (optional) ---
LEANCHAT_SSL_CERTFILE=None
LEANCHAT_SSL_KEYFILE=None

# --- Auto-Login (nur fuer Tests/E2E): kein Login noetig, Default-User wird verwendet ---
# LEANCHAT_AUTO_LOGIN=0

# --- E2E-Tests gegen ein echtes LLM (Opt-in, siehe docs/e2e_real_llm.md; nie automatisch aktiv) ---
# LEANCHAT_E2E_REAL_LLM=0
# LEANCHAT_E2E_LLM_BASE=http://127.0.0.1:1234/v1
# LEANCHAT_E2E_API_KEY=
